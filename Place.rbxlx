				<Properties>
					<ProtectedString name="Source"><![CDATA[local TweenService = game:GetService('TweenService')

local hitbox = script.Parent.Hitbox

local doors = {}
for _, v in script.Parent:GetChildren() do
	if v:IsA('Model') and string.match(v.Name,'Door')  then
		table.insert(doors,v)
	end
end

